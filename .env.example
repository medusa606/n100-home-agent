# Keep comments on their own lines: Docker Compose reads "KEY=   # note" as KEY="# note".

# ---- About you (goes into the system prompt) ----
USER_NAME=Your Name
INTERESTS=AI agents, LLMs, self-hosting, data engineering
LOCATION=London
TIMEZONE=Europe/London
# daily news+events digest; leave empty to disable
DIGEST_TIME=08:00

# ---- LLM (any OpenAI-compatible endpoint) ----
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
# or gemma4:e4b - run the eval and pick the winner
LLM_MODEL=qwen3:4b
# qwen3 only: skip the slow <think> phase
LLM_NO_THINK=true

# ---- Chat channel: telegram | signal | whatsapp ----
CHANNEL=telegram
# set to "signal" or "whatsapp" to start that bridge container
COMPOSE_PROFILES=
# Who may talk to the bot, comma separated. Unknown senders are logged with their ID so you
# can copy it here. Telegram: numeric chat id. Signal: +447700900123. WhatsApp: 4477...@c.us
ALLOWED_CHAT_IDS=
# where the daily digest goes
OWNER_CHAT_ID=

# Telegram: create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=

# Signal: your own number, after linking signal-cli as a device (see README)
SIGNAL_NUMBER=

# WhatsApp (WAHA) - needs a second number for the bot
WAHA_API_KEY=change-me-long-random
WAHA_DASHBOARD_PASSWORD=change-me

# ---- Home Assistant ----
HA_URL=http://host.docker.internal:8123
# Profile -> Security -> Long-lived access tokens
HA_TOKEN=
HA_ALLOWED_DOMAINS=light,switch,climate,cover,fan,media_player,scene,script,sensor,binary_sensor,input_boolean,lock
HA_CONFIRM_DOMAINS=lock,cover,alarm_control_panel

# ---- Web search ----
# generate with: openssl rand -hex 32
SEARXNG_SECRET=change-me-long-random

# ---- LinkedIn (optional) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/linkedin/callback
